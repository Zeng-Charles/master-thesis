<?xml version="1.0"?>
<robot name="base_link_robot">
    <material name="custom_color">
        <color rgba="0.7 0.7 0.7 1"/>
    </material>
    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="combined_wrapwrap.stl" scale="1 1 1"/>
            </geometry>
            <material name="custom_color"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="combined_wrapwrap.stl" scale="1 1 1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="60.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
    </link>
</robot>
