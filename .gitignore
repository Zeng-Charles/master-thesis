# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
build/
dist/

# IDE / OS
.idea/
.vscode/
.DS_Store
.claude/

# Isaac Sim / Omniverse
*.dmp
.thumbs/
_isaac_sim*
_repo
_build
.lastformat

# Run artefacts
outputs/*
!outputs/.gitkeep
wandb/
runs/
logs/
recordings/
videos/
*.tmp

# Datasets: downloaded or derived, never versioned. See README for how to obtain them.
# The directory structure itself is kept via .gitkeep files.
data/**
!data/raw/
!data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep

# Simulation assets. assets/patients/ is versioned through Git LFS (see .gitattributes)
# because those bodies are produced by this project. The rest -- bed, robots, probes,
# ultrasound models -- belongs to SonoGym and is downloaded into the submodule instead.
assets/robots/*
!assets/robots/.gitkeep
assets/probes/*
!assets/probes/.gitkeep
assets/scenes/*
!assets/scenes/.gitkeep
